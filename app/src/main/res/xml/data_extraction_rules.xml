<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. The auth token lives in `oxype_client_session`, so that preference file
    is excluded from cloud backup and device-to-device transfer alike.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="oxype_client_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="oxype_client_session.xml" />
    </device-transfer>
</data-extraction-rules>
